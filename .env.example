# Copy this file to .env.local and fill in the values from
# Supabase > Project Settings > API Keys (and Data API for the URL).
# .env.local is ignored by git — never commit real keys.

# Public values: they go inside the app (safe with RLS enabled).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Secret: used ONLY by `npm run seed` on your computer. Never prefix with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
